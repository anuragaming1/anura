-- Viền 7 màu
local borders = {}
local thickness = 5
local function createBorder(size, pos)
	local border = Instance.new("Frame")
	border.Size = size
	border.Position = pos
	border.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	border.BorderSizePixel = 0
	border.ZIndex = 10001
	border.Parent = FullUI
	table.insert(borders, border)
end
createBorder(UDim2.new(1, 0, 0, thickness), UDim2.new(0, 0, 0, 0))
createBorder(UDim2.new(1, 0, 0, thickness), UDim2.new(0, 0, 1, -thickness))
createBorder(UDim2.new(0, thickness, 1, 0), UDim2.new(0, 0, 0, 0))
createBorder(UDim2.new(0, thickness, 1, 0), UDim2.new(1, -thickness, 0, 0))

spawn(function()
	local hue = 0
	while true do
		local color = Color3.fromHSV(hue, 1, 1)
		for _, border in ipairs(borders) do
			TweenService:Create(border, TweenInfo.new(0.5), {BackgroundColor3 = color}):Play()
		end
		hue = (hue + 0.01) % 1
		wait(0.05)
	end
end)

